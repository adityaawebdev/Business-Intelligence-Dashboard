# Application Details
APP_NAME="InsightHub API"
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
API_V1_PREFIX=/api/v1

# Security & CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL 16/17/18)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/insighthub
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Logging
LOG_LEVEL=INFO
