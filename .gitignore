# ==========================================
# Root .gitignore for InsightHub Monorepo
# ==========================================

# Node & Frontend Dependencies & Builds
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
.vite/
**/.vite/

# Python & Backend Virtual Environments
venv/
**/venv/
.venv/
**/.venv/
env/
**/env/
ENV/
**/ENV/

# Python Cache & Bytecode
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
**/build/
develop-eggs/
eggs/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
**/.pytest_cache/
.coverage
**/htmlcov/

# Environment Variables & Secrets
.env
**/.env
.env.local
.env.*.local
.env.production
.env.development.local

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor Files
.DS_Store
Thumbs.db
.idea/
**/.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
